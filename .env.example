# Production: the app talks to the Gemini proxy (see proxy/README.md). No key goes in the app.
EXPO_PUBLIC_GEMINI_PROXY_URL=https://cook-ai-gemini-proxy.YOUR-SUBDOMAIN.workers.dev

# Local development only: calls Google directly. Leave this EMPTY (or delete it) in any
# environment that builds or publishes the app, because EXPO_PUBLIC_* values are compiled
# into the bundle. Check with: npm run check:bundle -- <exported dir>
EXPO_PUBLIC_GEMINI_API_KEY=
